{
  "projectId": "38b4b7d0-d18b-444c-92f7-df7991478e67",
  "type": "frontend",
  "name": "Explorer page loads with milestone table",
  "description": "The /explorer page loads, shows the title, stats bar, status filter buttons, and at least one milestone in the table.",
  "planSteps": [
    {
      "type": "action",
      "action": "navigate",
      "value": "https://weft.persidian.com",
      "description": "Navigate to the Weft landing page"
    },
    {
      "type": "action",
      "action": "click",
      "selector": "a[href='/explorer']",
      "description": "Click the Explorer link"
    },
    {
      "type": "assertion",
      "selector": "h1",
      "condition": "text-contains",
      "value": "Browse every milestone",
      "description": "Explorer h1 is visible"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "Total Milestones",
      "description": "Stats bar shows total milestones"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "ETH Staked",
      "description": "Stats bar shows staked ETH"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "Pending",
      "description": "Stats bar shows pending count"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "0x709ab5f0",
      "description": "A milestone entry is visible in the table"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "weft.thisyearnofear.eth",
      "description": "Milestone row shows the builder ENS"
    }
  ]
}