{
  "projectId": "38b4b7d0-d18b-444c-92f7-df7991478e67",
  "type": "frontend",
  "name": "Demo milestone lookup works",
  "description": "The milestone detail page for the demo milestone shows the heading, VERIFIED status, staked amount, and builder ENS.",
  "planSteps": [
    {
      "type": "action",
      "action": "navigate",
      "value": "https://weft.persidian.com",
      "description": "Navigate to the Weft landing page"
    },
    {
      "type": "action",
      "action": "navigate",
      "value": "https://weft.persidian.com/project/0x516975afcb46acf3ea2265789ea0a64516db9f1d8e6cfb65737fc9cfafb1c16f",
      "description": "Navigate to the demo milestone detail page"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "Weft demo milestone",
      "description": "Milestone heading displays 'Weft demo milestone'"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "Verified",
      "description": "Milestone status is Verified"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "0.0100",
      "description": "Milestone amount is 0.0100 ETH"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "weft.thisyearnofear.eth",
      "description": "Builder ENS is weft.thisyearnofear.eth"
    }
  ]
