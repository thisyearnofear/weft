{
  "projectId": "cdf9309d-9283-4db7-84a4-a6eee8599458",
  "type": "frontend",
  "name": "E2E user journey — landing to explorer to milestone to builder profile",
  "description": "Full user journey: land on home page, navigate to explorer, click a milestone, then navigate to the builder profile. Verify each step loads correctly.",
  "planSteps": [
    { "type": "action", "action": "navigate", "value": "https://weft.thisyearnofear.com", "description": "Start at the landing page" },
    { "type": "assertion", "selector": "h1", "condition": "visible", "description": "Landing page hero is visible" },
    { "type": "assertion", "selector": "main", "condition": "text-contains", "value": "Escrow", "description": "Landing page mentions Escrow" },
    { "type": "action", "action": "navigate", "value": "https://weft.thisyearnofear.com/explorer", "description": "Navigate to explorer" },
    { "type": "assertion", "selector": "h1", "condition": "text-contains", "value": "Every milestone", "description": "Explorer page loads" },
    { "type": "assertion", "selector": "table tbody tr", "condition": "visible", "description": "Explorer shows milestone table" },
    { "type": "action", "action": "navigate", "value": "https://weft.thisyearnofear.com/project/0x516975afcb46acf3ea2265789ea0a64516db9f1d8e6cfb65737fc9cfafb1c16f", "description": "Click through to milestone detail" },
    { "type": "assertion", "selector": "main", "condition": "visible", "description": "Milestone detail page loads" },
    { "type": "assertion", "selector": "main", "condition": "text-contains", "value": "0x516975", "description": "Milestone detail shows the correct hash" },
    { "type": "action", "action": "navigate", "value": "https://weft.thisyearnofear.com/builder/weft.thisyearnofear.eth", "description": "Navigate to builder profile" },
    { "type": "assertion", "selector": "h1", "condition": "text-contains", "value": "weft.thisyearnofear.eth", "description": "Builder profile loads with correct ENS" },
    { "type": "assertion", "selector": "main", "condition": "text-contains", "value": "Trust", "description": "Builder profile shows trust/reputation section" }
  ]
