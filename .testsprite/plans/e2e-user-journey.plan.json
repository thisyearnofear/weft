{
  "projectId": "38b4b7d0-d18b-444c-92f7-df7991478e67",
  "type": "frontend",
  "name": "E2E user journey \u2014 landing to explorer to milestone to builder profile",
  "description": "Full user journey: land on home page, navigate to explorer, click a milestone, then open the builder trust profile. Verify each step loads correctly.",
  "planSteps": [
    {
      "type": "action",
      "action": "navigate",
      "value": "https://weft.persidian.com",
      "description": "Navigate to the Weft landing page"
    },
    {
      "type": "action",
      "action": "click",
      "selector": "a[href='/explorer']",
      "description": "Click the Explorer link"
    },
    {
      "type": "action",
      "action": "click",
      "selector": "a[href='/project/0x709ab5f0c3ddd703a9ce74a4156840204df267bc5812dbdbb96e1eafd4d99891']",
      "description": "Click the 0x709ab5f0...d99891 milestone link"
    },
    {
      "type": "action",
      "action": "click",
      "selector": "a[href='/builder/weft.thisyearnofear.eth']",
      "description": "Click the Open trust profile link"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "Builder profile",
      "description": "The builder profile page heading is visible"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "weft.thisyearnofear.eth",
      "description": "The builder profile identifies weft.thisyearnofear.eth"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "Reputation Score",
      "description": "The builder profile displays a reputation score"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "85",
      "description": "Reputation score is 85"
    }
  ]
}