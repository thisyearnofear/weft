{
  "projectId": "38b4b7d0-d18b-444c-92f7-df7991478e67",
  "type": "frontend",
  "name": "Builder profile page shows reputation",
  "description": "The /builder/weft.thisyearnofear.eth page loads, shows the ENS name, reputation score, and verified milestone count.",
  "planSteps": [
    {
      "type": "action",
      "action": "navigate",
      "value": "https://weft.persidian.com",
      "description": "Navigate to the Weft landing page"
    },
    {
      "type": "action",
      "action": "click",
      "selector": "a[href='/explorer']",
      "description": "Click the Explorer link"
    },
    {
      "type": "action",
      "action": "click",
      "selector": "a[href='/builder/weft.thisyearnofear.eth']",
      "description": "Click the weft.thisyearnofear.eth builder link"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "weft.thisyearnofear.eth",
      "description": "Builder profile displays the ENS name weft.thisyearnofear.eth"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "Reputation Score",
      "description": "Builder profile shows a reputation score"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "85",
      "description": "Reputation score is 85"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "Verified Outcomes",
      "description": "Builder profile shows verified outcomes count"
    }
  ]
}