{
  "projectId": "38b4b7d0-d18b-444c-92f7-df7991478e67",
  "type": "frontend",
  "name": "API docs page loads with endpoint reference",
  "description": "The /api/docs page loads and shows documented API endpoints with methods, paths, and examples.",
  "planSteps": [
    {
      "type": "action",
      "action": "navigate",
      "value": "https://weft.persidian.com",
      "description": "Navigate to the Weft landing page"
    },
    {
      "type": "action",
      "action": "click",
      "selector": "button[aria-haspopup='true']",
      "description": "Click the Developers dropdown button"
    },
    {
      "type": "action",
      "action": "click",
      "selector": "a[href='/api/docs']",
      "description": "Click the API docs link"
    },
    {
      "type": "assertion",
      "selector": "h1",
      "condition": "text-contains",
      "value": "Public REST API",
      "description": "API docs h1 reads 'Public REST API'"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "/api/status/demo",
      "description": "GET /api/status/demo is documented"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "/api/status/milestone",
      "description": "GET /api/status/milestone/[hash] is documented"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "curl",
      "description": "Endpoint documentation includes a curl example"
    }
  ]
}