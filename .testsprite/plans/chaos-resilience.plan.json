{
  "projectId": "38b4b7d0-d18b-444c-92f7-df7991478e67",
  "type": "frontend",
  "name": "Chaos and resilience \u2014 operations page shows zero failures",
  "description": "The /operations dashboard hosts the chaos/resilience section. Verify Infrastructure Health reports zero failures and no active chaos.",
  "planSteps": [
    {
      "type": "action",
      "action": "navigate",
      "value": "https://weft.persidian.com",
      "description": "Navigate to the Weft landing page"
    },
    {
      "type": "action",
      "action": "click",
      "selector": "button[aria-haspopup='true']",
      "description": "Click the Developers dropdown button"
    },
    {
      "type": "action",
      "action": "click",
      "selector": "a[href='/operations']",
      "description": "Click the Operations link"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "Infrastructure Health",
      "description": "Infrastructure Health section is visible"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "Failures 0",
      "description": "Infrastructure Health reports zero failures (Failures 0)"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "Recovery Events",
      "description": "Recovery events indicator is present"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "Chaos Active",
      "description": "Chaos status indicator is present"
    }
  ]
}