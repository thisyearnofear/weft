{
  "projectId": "38b4b7d0-d18b-444c-92f7-df7991478e67",
  "type": "frontend",
  "name": "Onchain cross-check \u2014 explorer data matches milestone detail",
  "description": "The pending milestone 0x709ab5f0 appears on the explorer with builder weft.thisyearnofear.eth and 0.0010 ETH staked; its detail page shows the same builder, stake, and an unfinalized trust state.",
  "planSteps": [
    {
      "type": "action",
      "action": "navigate",
      "value": "https://weft.persidian.com",
      "description": "Navigate to the Weft landing page"
    },
    {
      "type": "action",
      "action": "click",
      "selector": "a[href='/explorer']",
      "description": "Click the Explorer link"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "0x709ab5f0",
      "description": "Explorer table shows milestone 0x709ab5f0...d99891"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "Pending",
      "description": "Explorer shows the milestone status Pending"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "weft.thisyearnofear.eth",
      "description": "Explorer shows builder weft.thisyearnofear.eth"
    },
    {
      "type": "action",
      "action": "click",
      "selector": "a[href='/project/0x709ab5f0c3ddd703a9ce74a4156840204df267bc5812dbdbb96e1eafd4d99891']",
      "description": "Open the milestone detail page"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "0.0010",
      "description": "Detail page shows the same 0.0010 ETH stake"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "weft.thisyearnofear.eth",
      "description": "Detail page shows the same builder ENS"
    },
    {
      "type": "assertion",
      "selector": "body",
      "condition": "text-contains",
      "value": "Trust still being established",
      "description": "Detail page shows the milestone is not yet finalized"
    }
  ]
}