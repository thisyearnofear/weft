# ── Weft Environment Configuration ──────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit real secrets to the repository.
#
# Usage:
#   cp .env.example .env.local
#   set -a; source .env.local; set +a

# ── Required ────────────────────────────────────────────────────────────────
ETH_RPC_URL=https://evmrpc-testnet.0g.ai              # 0G Chain EVM RPC
WEFT_CONTRACT_ADDRESS=0x9f66158c560ce5c8b40820fdcd2874ff8d852192
VERIFIER_ADDRESS=0xebe2ee532bA0c24d901A11f751E8c338Db053D76

# ── Signing Key ─────────────────────────────────────────────────────────────
# Use `cast wallet import verifier --interactive` to create an encrypted keystore.
# Then set CAST_ACCOUNT=verifier and provide CAST_PASSWORD.
# For scripts that need the raw key, you can set VERIFIER_PRIVATE_KEY, but
# prefer using the encrypted keystore in production.
# VERIFIER_PRIVATE_KEY=0x...

# ── Optional: Contract Addresses ────────────────────────────────────────────
VERIFIER_REGISTRY_ADDRESS=0x1356dd3f28461685ffd81d44f6ae9ae87937e34a
KEEPERHUB_RELAYER_ADDRESS=0x5EB72B6576581c38fa44BdFa6EcDFe8C13a1fB9c
WEFT_ENS_PARENT=thisyearnofear.eth

# ── Optional: API Keys ──────────────────────────────────────────────────────
KIMI_API_KEY=sk-...                                  # Moonshot/Kimi AI
FAL_KEY=...                                          # fal.ai image generation
KEEPERHUB_API_KEY=kh_...                             # KeeperHub reliable execution
ZERO_G_INDEXER_RPC=https://indexer-storage-testnet-standard.0g.ai

# ── Agent/Daemon ────────────────────────────────────────────────────────────
# POLL_INTERVAL=3600
# AXL_PORT=9002
# PUBLISH_0G=1
# AXL_BROADCAST=1
