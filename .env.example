# ── Weft Environment Configuration ──────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit real secrets to the repository.
#
# Usage:
#   cp .env.example .env.local
#   set -a; source .env.local; set +a

# ── Required ────────────────────────────────────────────────────────────────
ETH_RPC_URL=https://evmrpc-testnet.0g.ai              # 0G Chain EVM RPC
WEFT_CONTRACT_ADDRESS=0x9f66158c560ce5c8b40820fdcd2874ff8d852192
VERIFIER_ADDRESS=0xebe2ee532bA0c24d901A11f751E8c338Db053D76

# ── Signing Key ─────────────────────────────────────────────────────────────
# Use `cast wallet import verifier --interactive` to create an encrypted keystore.
# Then set CAST_ACCOUNT=verifier and provide CAST_PASSWORD.
# For scripts that need the raw key, you can set VERIFIER_PRIVATE_KEY, but
# prefer using the encrypted keystore in production.
# VERIFIER_PRIVATE_KEY=0x...

# ── Optional: Contract Addresses ────────────────────────────────────────────
VERIFIER_REGISTRY_ADDRESS=0x1356dd3f28461685ffd81d44f6ae9ae87937e34a
KEEPERHUB_RELAYER_ADDRESS=0x5EB72B6576581c38fa44BdFa6EcDFe8C13a1fB9c
WEFT_ENS_PARENT=thisyearnofear.eth

# ── Optional: API Keys ──────────────────────────────────────────────────────
KIMI_API_KEY=sk-...                                  # Moonshot/Kimi AI
FAL_KEY=...                                          # fal.ai image generation
KEEPERHUB_API_KEY=kh_...                             # KeeperHub reliable execution
ZERO_G_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai

# ── Agent/Daemon ────────────────────────────────────────────────────────────
# POLL_INTERVAL=3600
# AXL_PORT=9002
# PUBLISH_0G=1
# AXL_BROADCAST=1

# ── SigNoz / OpenTelemetry (optional) ──────────────────────────────────────
# Install with: pip install -r requirements-signoz.txt
# Set WEFT_OBSERVABILITY=signoz to export daemon traces, metrics, and recovery logs.
# Preferred hackathon path without local Docker: use SigNoz Cloud.
# WEFT_OBSERVABILITY=signoz
# OTEL_SERVICE_NAME=weft-daemon
# OTEL_RESOURCE_ATTRIBUTES=service.name=weft-daemon,deployment.environment=demo
# For the current SigNoz Cloud region, use https://ingest.us2.signoz.cloud:443.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.us2.signoz.cloud:443
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=your-ingestion-key
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# WEFT_OTEL_EXPORT_TIMEOUT=3
# For self-hosted SigNoz, set OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#
# SigNoz MCP/API uses a separate service-account API key:
# SIGNOZ_INSTANCE_URL=https://modest-mosquito.us2.signoz.cloud
# SIGNOZ_MCP_URL=https://mcp.us2.signoz.cloud/mcp
# SIGNOZ_API_KEY=store-this-outside-git
# SIGNOZ_ENDPOINT=https://modest-mosquito.us2.signoz.cloud
# SIGNOZ_ACCESS_TOKEN=store-this-outside-git  # Terraform dashboard/alert provisioning

# Frontend observability links (optional — auto-written by weft_signoz_provision.sh)
# NEXT_PUBLIC_SIGNOZ_INSTANCE_URL=https://modest-mosquito.us2.signoz.cloud
# NEXT_PUBLIC_SIGNOZ_DASHBOARD_URL=https://<instance>/dashboard/<id>

# ── Confidential milestones (Zama FHEVM, Sepolia) ───────────────────────────
# When both are set, the daemon routes verdicts through the sealed-ballot path:
# agent/lib/fhe_client.py encrypts the vote and submits to the confidential
# contract instead of the public one. Deployed address: see SUBMISSION.md.
# WEFT_MILESTONE_CONFIDENTIAL=0xaf29c8954c01bb39e370021b52da0685089fadc3
# FHE_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
